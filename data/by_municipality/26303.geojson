cialties":["たけのこ","京山科なす（京野菜）","みず菜"],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%A4%A7%E5%B1%B1%E5%B4%8E%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"大山崎町","wikipedia_revision_id":"110737395","wikidata_qid":"Q450287","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%A4%A7%E5%B1%B1%E5%B4%8E%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}