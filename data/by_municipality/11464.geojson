る可能性がある。水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["上原正吉"],"honorary_citizens":[],"tourism_landmarks":["恭倹舎・有隣塚","御成街道一里塚","杉戸宿本陣跡","目沼古墳群","目沼浅間塚古墳","永福寺","茨島八坂神社（夏祭り）","三上於菟吉の墓"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E6%9D%89%E6%88%B8%E7%94%BA","https://www.wikidata.org/wiki/Q11358601","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E4%B8%8A%E5%8E%9F%E6%AD%A3%E5%90%89&keyword=%E6%9D%89%E6%88%B8%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"杉戸町","wikipedia_revision_id":"110084990","wikidata_qid":"Q1345351","wikipedia_url":"https://ja.wikipedia.org/wiki/%E6%9D%89%E6%88%B8%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E4%B8%8A%E5%8E%9F%E6%AD%A3%E5%90%89&keyword=%E6%9D%89%E6%88%B8%E7%94%BA","status":"wikipedia_ok"}}