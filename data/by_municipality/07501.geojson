orical_domains":[],"heian_place_names":[],"japan_search_support":["財界ふくしま 8(6) https://jpsearch.go.jp/item/dignl-2832565"],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E7%9F%B3%E5%B7%9D%E7%94%BA","https://www.wikidata.org/wiki/Q11561759","https://www.wikidata.org/wiki/Q11461076","https://www.wikidata.org/wiki/Q11461468","https://www.wikidata.org/wiki/Q11677069","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%B8%8B%E8%B0%B7%E7%9B%B4%E8%94%B5&keyword=%E7%9F%B3%E5%B7%9D%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"石川町","wikipedia_revision_id":"110876378","wikidata_qid":"Q1205335","wikipedia_url":"https://ja.wikipedia.org/wiki/%E7%9F%B3%E5%B7%9D%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%B8%8B%E8%B0%B7%E7%9B%B4%E8%94%B5&keyword=%E7%9F%B3%E5%B7%9D%E7%94%BA","status":"wikipedia_ok"}}