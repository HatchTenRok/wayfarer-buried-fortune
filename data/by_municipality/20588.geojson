地点が探索の入口になる。 現地では史跡説明板、久木村、和佐尾村ゆかりの旧境石標や村の歴史案内板が手がかりになりそうだ。さらに水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["西沢広義","中村孝次郎","松本忠雄","戸谷成雄"],"honorary_citizens":[],"tourism_landmarks":["大洞高原 （星と緑のロマントピア）","小川天文台","プラネタリウム館","星と緑のロマン館","アルペンドーム","大洞池","小川の庄【縄文おやき村】","高山寺"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%B0%8F%E5%B7%9D%E6%9D%91","https://www.wikidata.org/wiki/Q715464","https://www.wikidata.org/wiki/Q28691663","https://www.wikidata.org/wiki/Q17230377","https://www.wikidata.org/wiki/Q11496612","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E8%A5%BF%E6%B2%A2%E5%BA%83%E7%BE%A9&keyword=%E5%B0%8F%E5%B7%9D%E6%9D%91"],"enrichment_errors":[],"wikipedia_title":"小川村","wikipedia_revision_id":"110708697","wikidata_qid":"Q1348971","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%B0%8F%E5%B7%9D%E6%9D%91","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E8%A5%BF%E6%B2%A2%E5%BA%83%E7%BE%A9&keyword=%E5%B0%8F%E5%B7%9D%E6%9D%91","status":"wikipedia_ok"}}