e":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%90%89%E5%B7%9D%E5%B8%82","https://www.wikidata.org/wiki/Q20039537","https://www.wikidata.org/wiki/Q11437008","https://www.wikidata.org/wiki/Q11456437"],"enrichment_errors":[],"wikipedia_title":"吉川市","wikipedia_revision_id":"110115265","wikidata_qid":"Q873546","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%90%89%E5%B7%9D%E5%B8%82","japan_search_query_url":"","status":"wikipedia_ok"}}