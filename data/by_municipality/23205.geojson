ble_people":["榊原伊三","中埜和英","大碇紋太郎","新美南吉","小栗風葉"],"honorary_citizens":[],"tourism_landmarks":["安養寺","常楽寺","雲観寺","光照寺","光照院","龍台院","神前神社","尾張三社"],"specialties":["生せんべい","ミツカン","復刻カブトビール"],"food_culture":[],"historical_domains":["尾張藩","犬山藩"],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%8D%8A%E7%94%B0%E5%B8%82","https://www.wikidata.org/wiki/Q11541670","https://www.wikidata.org/wiki/Q113632273","https://www.wikidata.org/wiki/Q11438296","https://www.wikidata.org/wiki/Q1989968","https://www.wikidata.org/wiki/Q11462045","https://www.wikidata.org/wiki/Q11649213"],"enrichment_errors":[],"wikipedia_title":"半田市","wikipedia_revision_id":"110652699","wikidata_qid":"Q463171","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%8D%8A%E7%94%B0%E5%B8%82","japan_search_query_url":"","status":"wikipedia_ok"}}