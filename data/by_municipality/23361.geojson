ない。","story_enrichment":{"samurai_priority_people":["堀尾吉晴","織田広近"],"notable_people":["堀尾吉晴","織田広近","野田正昇"],"honorary_citizens":[],"tourism_landmarks":["小口城（小口城址公園）","堀尾屋敷跡（堀尾城）","臨済宗全徳寺","臨済宗徳林寺","臨済宗観音寺","臨済宗妙徳寺","臨済宗薬師寺","臨済宗妙智寺"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%A4%A7%E5%8F%A3%E7%94%BA","https://www.wikidata.org/wiki/Q8190645","https://www.wikidata.org/wiki/Q11608371","https://www.wikidata.org/wiki/Q108111313","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%A0%80%E5%B0%BE%E5%90%89%E6%99%B4&keyword=%E5%A4%A7%E5%8F%A3%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"大口町","wikipedia_revision_id":"109731762","wikidata_qid":"Q1203960","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%A4%A7%E5%8F%A3%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%A0%80%E5%B0%BE%E5%90%89%E6%99%B4&keyword=%E5%A4%A7%E5%8F%A3%E7%94%BA","status":"wikipedia_ok"}}