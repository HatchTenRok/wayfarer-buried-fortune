rical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%BC%A5%E5%BD%A6%E6%9D%91","https://www.wikidata.org/wiki/Q6562008","https://www.wikidata.org/wiki/Q11564287","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E7%89%87%E5%B1%B1%E5%8C%97%E6%B5%B7&keyword=%E5%BC%A5%E5%BD%A6%E6%9D%91"],"enrichment_errors":[],"wikipedia_title":"弥彦村","wikipedia_revision_id":"109857134","wikidata_qid":"Q1349667","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%BC%A5%E5%BD%A6%E6%9D%91","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E7%89%87%E5%B1%B1%E5%8C%97%E6%B5%B7&keyword=%E5%BC%A5%E5%BD%A6%E6%9D%91","status":"wikipedia_ok"}}