可能性がある。水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":["長勝院"],"notable_people":["長勝院","内藤魯一","岩田新","天凰山豊"],"honorary_citizens":[],"tourism_landmarks":["牛田城址","重原城","知立古城跡","遍照院","総持寺","無量寿寺","萬福寺","小松寺"],"specialties":[],"food_culture":[],"historical_domains":["刈谷藩","陸奥国福島藩","重原藩"],"heian_place_names":["重原荘"],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E7%9F%A5%E7%AB%8B%E5%B8%82","https://www.wikidata.org/wiki/Q11651545","https://www.wikidata.org/wiki/Q11394578","https://www.wikidata.org/wiki/Q18700669","https://www.wikidata.org/wiki/Q17161582","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E9%95%B7%E5%8B%9D%E9%99%A2&keyword=%E7%9F%A5%E7%AB%8B%E5%B8%82"],"enrichment_errors":[],"wikipedia_title":"知立市","wikipedia_revision_id":"110301185","wikidata_qid":"Q223496","wikipedia_url":"https://ja.wikipedia.org/wiki/%E7%9F%A5%E7%AB%8B%E5%B8%82","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E9%95%B7%E5%8B%9D%E9%99%A2&keyword=%E7%9F%A5%E7%AB%8B%E5%B8%82","status":"wikipedia_ok"}}