の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["小松均","柴崎芳太郎","保芦邦人","宮川舩夫","森義八郎"],"honorary_citizens":[],"tourism_landmarks":["大石田まつり","最上川大花火大会","大石田ゴルフクラブ","大石田そば街道","乗船寺","あったまりランド"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%A4%A7%E7%9F%B3%E7%94%B0%E7%94%BA","https://www.wikidata.org/wiki/Q11461062","https://www.wikidata.org/wiki/Q11534691","https://www.wikidata.org/wiki/Q11385911","https://www.wikidata.org/wiki/Q135826095","https://www.wikidata.org/wiki/Q115090413","https://www.wikidata.org/wiki/Q11542568","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%B0%8F%E6%9D%BE%E5%9D%87&keyword=%E5%A4%A7%E7%9F%B3%E7%94%B0%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"大石田町","wikipedia_revision_id":"110466542","wikidata_qid":"Q1347263","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%A4%A7%E7%9F%B3%E7%94%B0%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%B0%8F%E6%9D%BE%E5%9D%87&keyword=%E5%A4%A7%E7%9F%B3%E7%94%B0%E7%94%BA","status":"wikipedia_ok"}}