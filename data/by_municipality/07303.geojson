能性がある。水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["富塚三夫"],"honorary_citizens":[],"tourism_landmarks":["国見町観月台文化センター","阿津賀志山防塁（国の史跡）。阿津賀志山の戦いで知られる。","石母田供養石塔（国の史跡）","石母田城跡（国見町史跡）","奥山家住宅（登録有形文化財）"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%9B%BD%E8%A6%8B%E7%94%BA","https://www.wikidata.org/wiki/Q11455836","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%AF%8C%E5%A1%9A%E4%B8%89%E5%A4%AB&keyword=%E5%9B%BD%E8%A6%8B%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"国見町","wikipedia_revision_id":"109712499","wikidata_qid":"Q1205612","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%9B%BD%E8%A6%8B%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%AF%8C%E5%A1%9A%E4%B8%89%E5%A4%AB&keyword=%E5%9B%BD%E8%A6%8B%E7%94%BA","status":"wikipedia_ok"}}