す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["竹中久次","堀井新治郎"],"honorary_citizens":[],"tourism_landmarks":["竜王町総合運動公園（岡屋）","滋賀県希望が丘文化公園（薬師、野洲市、湖南市）","妹背の里（川守）","苗村神社（綾戸）","鏡神社（鏡）","龍王寺（川守）","龍王寺の鐘にまつわる代表的な歌","暮れにきと 告ぐるぞ待たで 降りはるる 雪野の寺の 入相いの鐘（和泉式部）"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E7%AB%9C%E7%8E%8B%E7%94%BA","https://www.wikidata.org/wiki/Q17210379","https://www.wikidata.org/wiki/Q11427222"],"enrichment_errors":[],"wikipedia_title":"竜王町","wikipedia_revision_id":"109405243","wikidata_qid":"Q1087560","wikipedia_url":"https://ja.wikipedia.org/wiki/%E7%AB%9C%E7%8E%8B%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}