河川改修の記念碑が狙い目になる。山上藩ゆかりの領主碑や旧領境を示すしるべにも期待できる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["武村正義","出目昌伸","阿部市郎兵衛（7代）","田附政次郎","塚本幸一"],"honorary_citizens":[],"tourism_landmarks":["鈴鹿国定公園","万葉の森船岡山（『万葉集』所載の額田王と大海人皇子の相聞歌の歌碑がある）","能登川水車とカヌーランド","永源寺","百済寺","石塔寺","梵釈寺","石馬寺"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E6%9D%B1%E8%BF%91%E6%B1%9F%E5%B8%82","https://www.wikidata.org/wiki/Q130854","https://www.wikidata.org/wiki/Q249675","https://www.wikidata.org/wiki/Q17191683","https://www.wikidata.org/wiki/Q107199402","https://www.wikidata.org/wiki/Q11428480","https://www.wikidata.org/wiki/Q11645220","https://www.wikidata.org/wiki/Q17215183","https://www.wikidata.org/wiki/Q11428514","https://www.wikidata.org/wiki/Q2442233","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%AD%A6%E6%9D%91%E6%AD%A3%E7%BE%A9&keyword=%E6%9D%B1%E8%BF%91%E6%B1%9F%E5%B8%82"],"enrichment_errors":[],"wikipedia_title":"東近江市","wikipedia_revision_id":"109970594","wikidata_qid":"Q240891","wikipedia_url":"https://ja.wikipedia.org/wiki/%E6%9D%B1%E8%BF%91%E6%B1%9F%E5%B8%82","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%AD%A6%E6%9D%91%E6%AD%A3%E7%BE%A9&keyword=%E6%9D%B1%E8%BF%91%E6%B1%9F%E5%B8%82","status":"wikipedia_ok"}}