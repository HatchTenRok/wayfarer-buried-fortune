点が探索の入口になる。 現地では村木村、緒川村ゆかりの旧境石標や村の歴史案内板が手がかりになりそうだ。さらに水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":["於大の方"],"notable_people":["於大の方","安井治雄","久松潜一","久米常民"],"honorary_citizens":[],"tourism_landmarks":["入海貝塚","絹本著色弁財天像","絹本著色諸尊集会図","紙本墨書正法眼蔵写本","異国降伏祈願施行状","知多の虫供養行事","藤江のだんつく獅子舞","大樹寺旧裏一の門"],"specialties":[],"food_culture":[],"historical_domains":["尾張藩"],"heian_place_names":[],"japan_search_support":["於大の方の一生 : 徳川家康の生母 https://jpsearch.go.jp/item/bibnl-73010402","於大の方の一生 : 徳川家康の生母 https://jpsearch.go.jp/item/dignl-12253496"],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E6%9D%B1%E6%B5%A6%E7%94%BA","https://www.wikidata.org/wiki/Q5366163","https://www.wikidata.org/wiki/Q126945803","https://www.wikidata.org/wiki/Q11369442","https://www.wikidata.org/wiki/Q114564216","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%96%BC%E5%A4%A7%E3%81%AE%E6%96%B9&keyword=%E6%9D%B1%E6%B5%A6%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"東浦町","wikipedia_revision_id":"110299218","wikidata_qid":"Q677745","wikipedia_url":"https://ja.wikipedia.org/wiki/%E6%9D%B1%E6%B5%A6%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%96%BC%E5%A4%A7%E3%81%AE%E6%96%B9&keyword=%E6%9D%B1%E6%B5%A6%E7%94%BA","status":"wikipedia_ok"}}