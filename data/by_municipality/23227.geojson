る領主・城下の記憶が残る。 この地域には寺社や信仰の場、史跡や遺跡、古墳や貝塚に関わる場所が見え、王江遺跡、恩任寺、正林寺貝塚のような地点が探索の入口になる。 現地では城跡・陣屋跡、史跡説明板、高浜村、吉浜村ゆかりの旧境石標や村の歴史案内板が手がかりになりそうだ。さらに西端藩ゆかりの領主碑や旧領境を示すしるべにも期待できる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["山本吉兵衛","内藤繁春"],"honorary_citizens":[],"tourism_landmarks":["観音寺（衣浦観音）","常照院","正林寺","専修坊","恩任寺","大聖寺","大日寺","春日神社"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E9%AB%98%E6%B5%9C%E5%B8%82","https://www.wikidata.org/wiki/Q123408633","https://www.wikidata.org/wiki/Q11394545","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%B1%B1%E6%9C%AC%E5%90%89%E5%85%B5%E8%A1%9B&keyword=%E9%AB%98%E6%B5%9C%E5%B8%82"],"enrichment_errors":[],"wikipedia_title":"高浜市","wikipedia_revision_id":"110264930","wikidata_qid":"Q816734","wikipedia_url":"https://ja.wikipedia.org/wiki/%E9%AB%98%E6%B5%9C%E5%B8%82","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E5%B1%B1%E6%9C%AC%E5%90%89%E5%85%B5%E8%A1%9B&keyword=%E9%AB%98%E6%B5%9C%E5%B8%82","status":"wikipedia_ok"}}