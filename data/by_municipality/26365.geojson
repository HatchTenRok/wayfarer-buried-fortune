dia_title":"和束町","wikipedia_revision_id":"110741121","wikidata_qid":"Q1203583","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%92%8C%E6%9D%9F%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}