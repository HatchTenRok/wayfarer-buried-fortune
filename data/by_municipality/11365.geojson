":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%B0%8F%E9%B9%BF%E9%87%8E%E7%94%BA","https://www.wikidata.org/wiki/Q11439158"],"enrichment_errors":[],"wikipedia_title":"小鹿野町","wikipedia_revision_id":"110120232","wikidata_qid":"Q1345311","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%B0%8F%E9%B9%BF%E9%87%8E%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}