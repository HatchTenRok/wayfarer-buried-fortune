らに田・新田・用水の地名が多く、土地改良碑や用水記念碑が見つかる可能性がある。","story_enrichment":{"samurai_priority_people":[],"notable_people":["増田連也","矢口昇"],"honorary_citizens":[],"tourism_landmarks":["渡良瀬遊水地","わたらせ自然館","板倉滑空場 -グライダー","雷電神社","高鳥天満宮","権現沼貝塚群","寺西貝塚","頼母子のシダレザクラ"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E6%9D%BF%E5%80%89%E7%94%BA","https://www.wikidata.org/wiki/Q100454736","https://www.wikidata.org/wiki/Q108110721"],"enrichment_errors":[],"wikipedia_title":"板倉町","wikipedia_revision_id":"110135976","wikidata_qid":"Q1203771","wikipedia_url":"https://ja.wikipedia.org/wiki/%E6%9D%BF%E5%80%89%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}