oint","coordinates":[136.020623,34.738214]}},{"type":"Feature","properties":{"layer_id":"cultural_facilities","name":"南山城村総合グラウンド","category":"public","address":"大字田山小字ツルギ54-2","source":"国土交通省 国土数値情報","municipality_code":"26367","municipality_pref":"京都府","municipality_name":"南山城村","municipality_code_method":"nearest_centroid"},"geometry":{"type":"Point","coordinates":[136.015369,34.753215]}},{"type":"Feature","properties":{"layer_id":"tourism_resources","name":"竜仙房","category":"nature","address":"山地（非火山性）景観 / 非火山性高原","source":"国土交通省 国土数値情報","municipality_code":"26367","municipality_pref":"京都府","municipality_name":"南山城村","municipality_code_method":"nearest_centroid","resource_code":"203"},"geometry":{"type":"Point","coordinates":[135.97207641601562,34.80375671386719]}}],"display_comment_original":"南山城村周辺には、近世村の記憶として田山村、高尾村、北大河原村などの旧村名が見える。 まずは城跡・武家文化、社寺・地域信仰を軸に、地区の由緒を拾える場所を探したい。 現地では田山村、高尾村ゆかりの旧境石標や村の歴史案内板が手がかりになりそうだ。さらに水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":[],"honorary_citizens":[],"tourism_landmarks":["日本遺産","観音寺","春光寺","真輪院","總神寺","地蔵寺","ないおん寺","大神宮社"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%8D%97%E5%B1%B1%E5%9F%8E%E6%9D%91"],"enrichment_errors":[],"wikipedia_title":"南山城村","wikipedia_revision_id":"110741129","wikidata_qid":"Q1203714","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%8D%97%E5%B1%B1%E5%9F%8E%E6%9D%91","japan_search_query_url":"","status":"wikipedia_ok"}}