s":[],"tourism_landmarks":["Jヴィレッジ","マミーすいとん","楢葉町コミュニティセンター","道の駅ならは","ならは羽黒山温泉","天神岬温泉"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":["楢葉郷","白田郷","石城郡","楢葉郡"],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E6%A5%A2%E8%91%89%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"楢葉町","wikipedia_revision_id":"109525704","wikidata_qid":"Q1354867","wikipedia_url":"https://ja.wikipedia.org/wiki/%E6%A5%A2%E8%91%89%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}