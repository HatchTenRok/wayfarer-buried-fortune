水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["松尾多勢子","河野秀男","村沢牧","片桐典徳","山本弘"],"honorary_citizens":[],"tourism_landmarks":["壬生沢不動滝","新九郎の滝","巨大ポットホール","笹見平のしだれ桜","鬼面山麓の大トチノキ","野田平こぶしの群生林","泉龍院の三色藤","野田平キャンプ場"],"specialties":["松茸","市田柿","りんご","源助かぶ菜"],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":["松尾多勢子 https://jpsearch.go.jp/item/bibnl-22034460"],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E8%B1%8A%E4%B8%98%E6%9D%91","https://www.wikidata.org/wiki/Q11529599","https://www.wikidata.org/wiki/Q18818431","https://www.wikidata.org/wiki/Q11523342","https://www.wikidata.org/wiki/Q55534458","https://www.wikidata.org/wiki/Q11469051","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%9D%BE%E5%B0%BE%E5%A4%9A%E5%8B%A2%E5%AD%90&keyword=%E8%B1%8A%E4%B8%98%E6%9D%91"],"enrichment_errors":[],"wikipedia_title":"豊丘村","wikipedia_revision_id":"110121181","wikidata_qid":"Q44545","wikipedia_url":"https://ja.wikipedia.org/wiki/%E8%B1%8A%E4%B8%98%E6%9D%91","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E6%9D%BE%E5%B0%BE%E5%A4%9A%E5%8B%A2%E5%AD%90&keyword=%E8%B1%8A%E4%B8%98%E6%9D%91","status":"wikipedia_ok"}}