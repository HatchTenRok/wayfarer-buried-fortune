領境を示すしるべにも期待できる。","story_enrichment":{"samurai_priority_people":[],"notable_people":["つげ義春","春日錦孝嘉","河野密","吉原三郎","青木半治"],"honorary_citizens":[],"tourism_landmarks":["出雲大社上総分院（上総出雲大社）","小浜八幡神社","大原八幡神社","廣田神社","清水寺（坂東三十三観音霊場32番札所）","大聖寺","行元寺（波の伊八、欄間彫刻「波と宝珠」）","長福寺（波の伊八、欄間彫刻「波雲に龍」、「波に麒麟」）"],"specialties":[],"food_culture":[],"historical_domains":["大多喜藩","苅谷藩"],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E3%81%84%E3%81%99%E3%81%BF%E5%B8%82","https://www.wikidata.org/wiki/Q1353888","https://www.wikidata.org/wiki/Q6374880","https://www.wikidata.org/wiki/Q11554187","https://www.wikidata.org/wiki/Q11412688","https://www.wikidata.org/wiki/Q5648250","https://www.wikidata.org/wiki/Q17991307","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E3%81%A4%E3%81%92%E7%BE%A9%E6%98%A5&keyword=%E3%81%84%E3%81%99%E3%81%BF%E5%B8%82"],"enrichment_errors":[],"wikipedia_title":"いすみ市","wikipedia_revision_id":"110659600","wikidata_qid":"Q840834","wikipedia_url":"https://ja.wikipedia.org/wiki/%E3%81%84%E3%81%99%E3%81%BF%E5%B8%82","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E3%81%A4%E3%81%92%E7%BE%A9%E6%98%A5&keyword=%E3%81%84%E3%81%99%E3%81%BF%E5%B8%82","status":"wikipedia_ok"}}