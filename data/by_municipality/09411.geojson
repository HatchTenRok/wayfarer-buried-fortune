跡、松野城跡のような地点が探索の入口になる。 現地では史跡説明板が手がかりになりそうだ。さらに水辺の暮らしや堤防整備の歴史を示す案内板に加え、治水碑や河川改修の記念碑が狙い目になる。","story_enrichment":{"samurai_priority_people":["那須与一"],"notable_people":["那須与一","北島秀朝","菊池寛実","深沢史朗","箱石シツイ"],"honorary_citizens":[],"tourism_landmarks":["唐御所横穴墓群","神田城（国史跡）","御前岩（女陰を呈した自然石・奇岩）","駒形大塚古墳","那須官衙遺跡","いわむらかずお絵本の丘美術館","栃木県立なす風土記の丘資料館小川館","那珂川町小川資料館"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":["那須神田城跡 https://jpsearch.go.jp/item/SHUGYOKU1-1341025"],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E9%82%A3%E7%8F%82%E5%B7%9D%E7%94%BA","https://www.wikidata.org/wiki/Q2625800","https://www.wikidata.org/wiki/Q17210989","https://www.wikidata.org/wiki/Q18701147","https://www.wikidata.org/wiki/Q108110965","https://www.wikidata.org/wiki/Q124479841","https://www.wikidata.org/wiki/Q3194491","https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E9%82%A3%E9%A0%88%E4%B8%8E%E4%B8%80&keyword=%E9%82%A3%E7%8F%82%E5%B7%9D%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"那珂川町","wikipedia_revision_id":"110646183","wikidata_qid":"Q44603","wikipedia_url":"https://ja.wikipedia.org/wiki/%E9%82%A3%E7%8F%82%E5%B7%9D%E7%94%BA","japan_search_query_url":"https://jpsearch.go.jp/csearch/jps-cross?csid=jps-cross&keyword=%E9%82%A3%E9%A0%88%E4%B8%8E%E4%B8%80&keyword=%E9%82%A3%E7%8F%82%E5%B7%9D%E7%94%BA","status":"wikipedia_ok"}}