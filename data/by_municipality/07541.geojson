ory_enrichment":{"samurai_priority_people":[],"notable_people":[],"honorary_citizens":[],"tourism_landmarks":["奥州日の出の松","北迫地蔵尊","二ッ沼歌碑","汽車の碑","楢葉八幡神社","高倉城跡","Jヴィレッジ","二ツ沼総合公園"],"specialties":[],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%BA%83%E9%87%8E%E7%94%BA"],"enrichment_errors":[],"wikipedia_title":"広野町","wikipedia_revision_id":"109197920","wikidata_qid":"Q1354828","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%BA%83%E9%87%8E%E7%94%BA","japan_search_query_url":"","status":"wikipedia_ok"}}