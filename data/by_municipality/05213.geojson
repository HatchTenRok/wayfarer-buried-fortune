なりそうだ。さらに水辺の由緒を示す歴史案内板も見つかるかもしれない。","story_enrichment":{"samurai_priority_people":[],"notable_people":["高橋本吉","成田直衛","河田与惣左衛門","畠山健治郎","三浦久"],"honorary_citizens":[],"tourism_landmarks":["水の郷百選","日本の滝百選","日本二百名山","にほんの里100選","東北百名山","新観光秋田30景","観光秋田30景","東北の駅百選"],"specialties":["ヤマノイモ・シシトウガラシ・マルメロ・アユなど","山刀・阿仁焼・秋田八丈・珪藻土・パーライト","比内地鶏・バター餅・なんこ鍋・さば寿司・きりたんぽ鍋（農山漁村の郷土料理百選）"],"food_culture":[],"historical_domains":[],"heian_place_names":[],"japan_search_support":[],"enrichment_sources":["https://ja.wikipedia.org/wiki/%E5%8C%97%E7%A7%8B%E7%94%B0%E5%B8%82","https://www.wikidata.org/wiki/Q18233515","https://www.wikidata.org/wiki/Q11495702","https://www.wikidata.org/wiki/Q73111915","https://www.wikidata.org/wiki/Q11578614","https://www.wikidata.org/wiki/Q11356337","https://www.wikidata.org/wiki/Q21700699","https://www.wikidata.org/wiki/Q11613961","https://www.wikidata.org/wiki/Q11562158","https://www.wikidata.org/wiki/Q7681184","https://www.wikidata.org/wiki/Q11450707","https://www.wikidata.org/wiki/Q11450705","https://www.wikidata.org/wiki/Q17362559"],"enrichment_errors":[],"wikipedia_title":"北秋田市","wikipedia_revision_id":"110567202","wikidata_qid":"Q653545","wikipedia_url":"https://ja.wikipedia.org/wiki/%E5%8C%97%E7%A7%8B%E7%94%B0%E5%B8%82","japan_search_query_url":"","status":"wikipedia_ok"}}